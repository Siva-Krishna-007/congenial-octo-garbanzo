# Copy to .env and adjust as needed. All of these are optional — sensible
# defaults are used if this file (or a given line) is absent.

# Where your Qdrant instance is running. This app connects to it but does
# NOT start/manage it -- you're expected to already have it running
# yourself: qdrant.exe (Windows prebuilt binary), Docker
# ("docker run -p 6333:6333 qdrant/qdrant"), or the Qdrant Cloud. Default: http://localhost:6333
# QDRANT_URL=http://localhost:6333

# Which Qdrant collection to use by default. Created automatically on your
# first upload if it doesn't exist yet (vector size is picked up from
# whatever your embedding model produces). Point this at an existing,
# already-populated collection to use it as-is. Default: zoho_data
# QDRANT_COLLECTION=zoho_data

# Port the Express API listens on. Default: 5001
# PORT=5001
